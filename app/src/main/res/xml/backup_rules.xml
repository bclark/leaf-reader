<?xml version="1.0" encoding="utf-8"?>
<!-- Automatic Android cloud backup is disabled. Recovery uses explicit JSON export/restore in
     Menu -> Backup & Restore, or Android 12+ device-to-device database transfer configured in
     data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
