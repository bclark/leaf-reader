<?xml version="1.0" encoding="utf-8"?>
<!-- Automatic Android cloud backup is disabled while preserving database-only device-to-device
     transfer (library metadata, reading progress, and reading lists; never imported comic files,
     covers, or SMB credentials in shared preferences). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
