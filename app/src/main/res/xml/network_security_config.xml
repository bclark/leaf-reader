<?xml version="1.0" encoding="utf-8"?>
<!-- Network security configuration for Leaf.
     HTTPS with system CAs is standard. Cleartext HTTP is permitted for local network
     Jellyfin servers (e.g. 192.168.x.x, .local) only after explicit user confirmation
     and strict private IP/LAN host verification in JellyfinServerConfig. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
