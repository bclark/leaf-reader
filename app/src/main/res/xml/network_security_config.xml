<?xml version="1.0" encoding="utf-8"?>
<!-- The platform base configuration permits cleartext; it does not enforce LAN-only traffic.
     JellyfinServerConfig requires explicit consent and a local HTTP host spelling.
     JellyfinClient additionally validates the resolved address candidates used by direct
     cleartext connections and enforces redirect rules. HTTPS uses system CAs. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
