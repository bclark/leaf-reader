    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Leaf connects to your SMB drive or Jellyfin server to browse and download comics you choose."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Leaf se conecta a tu unidad SMB o servidor Jellyfin para explorar y descargar los cómics que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Leaf se connecte à votre serveur SMB ou Jellyfin pour parcourir et télécharger les BD que vous choisissez."
          }
        }
