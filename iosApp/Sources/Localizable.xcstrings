    "HTTP exposes your password, token, and comics to others on the network. Use only with a trusted local server.": {
      "comment": "A description of the risks of using unencrypted HTTP.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "HTTP expone tu contraseña, token y cómics a otras personas en la red. Úsalo solo con un servidor local de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Avec HTTP, votre mot de passe, votre jeton et vos BD sont exposés aux autres personnes sur le réseau. À utiliser uniquement avec un serveur local de confiance."
          }
        }
      }
    },
