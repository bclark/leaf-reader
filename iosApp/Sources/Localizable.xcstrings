    },
    "This linked comic is unavailable. Check Files and retry, or locate the original file.": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cómic vinculado no está disponible. Revisa Archivos y vuelve a intentarlo o localiza el archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Cette BD liée est indisponible. Vérifiez Fichiers et réessayez, ou localisez le fichier d’origine."
          }
        }
      }
    },
    "This is a different file. Locate the original comic to keep this link.": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es distinto. Localiza el cómic original para conservar el vínculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Il s’agit d’un autre fichier. Localisez la BD d’origine pour conserver ce lien."
          }
        }
      }
    },
    "The original in Files stays untouched. Leaf removes this shelf entry and its reading progress.": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original en Archivos no cambia. Leaf quita el cómic de la biblioteca y borra su progreso de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Le fichier d’origine dans Fichiers reste intact. Leaf supprime cette entrée de la bibliothèque et sa progression de lecture."
          }
        }
      }
    },
